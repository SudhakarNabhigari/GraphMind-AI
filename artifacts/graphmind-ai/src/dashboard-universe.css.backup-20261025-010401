}

.dashboard-universe button {
  transition:
    transform .2s ease,
    filter .2s ease,
    box-shadow .2s ease;
}

.dashboard-universe button:hover {
  filter: brightness(1.09);
}

.dashboard-universe button:active {
  transform: scale(.975);
}

.dashboard-universe :is(button, a, input, [tabindex]):focus-visible {
  outline: 2px solid rgba(111, 220, 255, .85);
  outline-offset: 3px;
}

