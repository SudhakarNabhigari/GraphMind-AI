@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
@import 'tailwindcss';
@import 'tw-animate-css';

:root {
  --background: 220 55% 6%;
  --foreground: 216 33% 92%;
  --card: 218 49% 10%;
  --card-foreground: 216 33% 92%;
  --card-border: 218 37% 17%;
  --popover: 218 46% 10%;
  --popover-foreground: 216 33% 92%;
  --popover-border: 218 37% 18%;
  --primary: 251 100% 64%;
  --primary-foreground: 0 0% 100%;
  --secondary: 217 44% 14%;
  --secondary-foreground: 216 27% 84%;
  --muted: 218 35% 13%;
  --muted-foreground: 216 14% 58%;
  --accent: 217 45% 16%;
  --accent-foreground: 216 33% 92%;
  --destructive: 0 75% 59%;
  --destructive-foreground: 0 0% 100%;
  --border: 218 35% 17%;
  --input: 218 35% 20%;
  --ring: 251 100% 64%;
  --chart-1: 251 100% 64%;
  --chart-2: 203 100% 58%;
  --chart-3: 169 67% 50%;
  --chart-4: 43 96% 57%;
  --chart-5: 187 85% 53%;
  --sidebar: 220 55% 6%;
  --sidebar-foreground: 216 25% 79%;
  --sidebar-border: 218 39% 14%;
  --sidebar-primary: 251 100% 64%;
  --sidebar-primary-foreground: 0 0% 100%;
  --sidebar-accent: 218 43% 13%;
  --sidebar-accent-foreground: 216 33% 92%;
  --sidebar-ring: 251 100% 64%;
  --app-font-sans: 'Plus Jakarta Sans', sans-serif;
  --app-font-serif: Georgia, serif;
  --app-font-mono: 'DM Mono', monospace;
  --radius: 0.85rem;
  --shadow: 0 18px 52px rgba(2, 8, 22, .34);
}

.dark { color-scheme: dark; }
@theme inline {
  --color-background: hsl(var(--background)); --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border)); --color-input: hsl(var(--input)); --color-ring: hsl(var(--ring));
  --color-card: hsl(var(--card)); --color-card-foreground: hsl(var(--card-foreground));
  --color-primary: hsl(var(--primary)); --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary)); --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted)); --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent)); --color-accent-foreground: hsl(var(--accent-foreground));
  --font-sans: var(--app-font-sans); --font-mono: var(--app-font-mono);
  --radius-sm: calc(var(--radius) - 4px); --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius); --radius-xl: calc(var(--radius) + 4px);
}
* { box-sizing: border-box; }
html { min-height: 100%; background: #050b18; }
body { margin: 0; min-height: 100dvh; background: #050b18; color: #e8edf8; font-family: var(--app-font-sans); -webkit-font-smoothing: antialiased; }
button, input, textarea { font: inherit; }
button { cursor: pointer; }
::selection { background: rgba(101,70,255,.35); }
.app-shell { min-height: 100dvh; background: radial-gradient(ellipse at 72% -20%, rgba(34, 95, 183, .12), transparent 45%), #050b18; }
.glass { background: linear-gradient(145deg, rgba(12, 25, 46, .94), rgba(8, 19, 37, .88)); border: 1px solid rgba(111, 139, 183, .15); box-shadow: 0 16px 45px rgba(0,0,0,.16), inset 0 1px 0 rgba(255,255,255,.025); }
.grid-glow { background-image: linear-gradient(rgba(80,110,160,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(80,110,160,.045) 1px, transparent 1px); background-size: 32px 32px; }
.ambient:before { content:''; position:fixed; inset:0; pointer-events:none; z-index:80; opacity:.12; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E"); }
.fade-up { animation: rise .45s cubic-bezier(.2,.75,.25,1) both; }
@keyframes rise { from { opacity:0; transform:translateY(10px) } to { opacity:1; transform:translateY(0) } }
.scrollbar-thin { scrollbar-width: thin; scrollbar-color: #263854 transparent; }
@media (prefers-reduced-motion: reduce) { *, *:before, *:after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; } }
