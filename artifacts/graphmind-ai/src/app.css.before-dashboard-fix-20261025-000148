:root {
  color-scheme: dark;
  --gm-bg: #050b18;
  --gm-surface: #0a1427;
  --gm-surface-raised: #0d1b31;
  --gm-border: rgba(100, 158, 235, .19);
  --gm-text: #edf4ff;
  --gm-muted: #8498b7;
  --gm-purple: #8957ff;
  --gm-blue: #1597ff;
  --gm-teal: #00d7c0;
  --gm-orange: #ffae42;
}

.app-shell.ambient {
  background:
    radial-gradient(ellipse at 80% -10%, rgba(64, 66, 190, .13), transparent 38%),
    radial-gradient(ellipse at 0% 70%, rgba(16, 93, 192, .09), transparent 35%),
    var(--gm-bg) !important;
  color: var(--gm-text);
}

.app-shell,
.app-shell * {
  box-sizing: border-box;
}

.app-shell .sidebar {
  background: linear-gradient(180deg, #081326 0%, #061020 100%);
  border-right: 1px solid rgba(91, 151, 231, .20);
  backdrop-filter: blur(20px);
}

.app-shell .brand-mark {
  border: 1px solid rgba(60, 158, 255, .45);
  box-shadow: 0 0 24px rgba(43, 121, 255, .19),
              inset 0 0 16px rgba(72, 101, 255, .14);
}

.app-shell .brand em {
  color: #a58aff;
  font-style: normal;
}

.app-shell .workspace-label {
  color: #7289ab;
  letter-spacing: .13em;
}

.app-shell .nav-link {
  position: relative;
  border: 1px solid transparent;
  border-radius: 10px;
  transition: background .22s ease, border-color .22s ease,
              color .22s ease, transform .22s ease, box-shadow .22s ease;
}

.app-shell .nav-link:hover {
  background: rgba(59, 108, 194, .13);
  border-color: rgba(103, 150, 241, .18);
  transform: translateX(2px);
}

.app-shell .nav-link.active {
  background: linear-gradient(110deg, #6542ef, #5140d4) !important;
  color: #fff !important;
  border-color: rgba(177, 151, 255, .37);
  box-shadow: 0 5px 24px rgba(94, 65, 245, .24),
              inset 0 1px rgba(255, 255, 255, .13);
}

.app-shell .topbar {
  background: rgba(5, 12, 26, .82);
  border-bottom: 1px solid rgba(100, 158, 235, .14);
  backdrop-filter: blur(18px);
}

.app-shell .top-search {
  background: rgba(13, 28, 49, .84);
  border: 1px solid rgba(101, 149, 218, .22);
  border-radius: 10px;
  transition: border-color .2s ease, box-shadow .2s ease;
}

.app-shell .top-search:focus-within {
  border-color: rgba(83, 148, 255, .7);
  box-shadow: 0 0 0 3px rgba(45, 121, 255, .10);
}

.app-shell .content {
  color: var(--gm-text);
}

.app-shell .page-stack {
  gap: 20px;
}

.app-shell .page-header {
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 2px;
}

.app-shell .eyebrow {
  color: #7893b8;
  letter-spacing: .13em;
  font-size: 10px;
  font-weight: 750;
}

.app-shell .page-header h1 {
  color: #f0f5ff;
  letter-spacing: -.045em;
  line-height: 1.18;
}

.app-shell .page-header p {
  color: #8ea1bf;
  line-height: 1.7;
}

.app-shell .title-dot {
  color: #9975ff;
}

.app-shell .glass.panel {
  position: relative;
  background: linear-gradient(145deg,
    rgba(13, 27, 48, .96),
    rgba(7, 18, 34, .96)) !important;
  border: 1px solid var(--gm-border) !important;
  border-radius: 14px !important;
  box-shadow: inset 0 1px rgba(255, 255, 255, .025),
              0 8px 28px rgba(0, 0, 0, .10);
  transition: border-color .25s ease, box-shadow .25s ease,
              transform .25s ease;
}

.app-shell .glass.panel:hover {
  border-color: rgba(106, 151, 238, .36) !important;
  box-shadow: inset 0 1px rgba(255, 255, 255, .035),
              0 10px 32px rgba(0, 0, 0, .16);
}

.app-shell .panel-heading {
  gap: 12px;
}

.app-shell .panel-heading h2 {
  color: #e7efff;
  letter-spacing: -.025em;
}

.app-shell .text-link {
  color: #9c91ff;
  transition: color .2s ease, gap .2s ease;
}

.app-shell .text-link:hover {
  color: #c2b7ff;
}

.app-shell .button-primary,
.app-shell .button.button-primary {
  background: linear-gradient(115deg, #7650ff, #5941e8) !important;
  color: white !important;
  border: 1px solid rgba(183, 163, 255, .42) !important;
  box-shadow: 0 5px 20px rgba(101, 66, 245, .24),
              inset 0 1px rgba(255, 255, 255, .14);
  transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.app-shell .button-primary:hover,
.app-shell .button.button-primary:hover {
  transform: translateY(-2px);
  filter: brightness(1.09);
  box-shadow: 0 8px 26px rgba(101, 66, 245, .36);
}

.app-shell .button-secondary,
.app-shell .button-quiet {
  background: rgba(19, 36, 61, .75);
  border-color: rgba(104, 150, 219, .22);
}

.app-shell .button-secondary:hover,
.app-shell .button-quiet:hover {
  border-color: rgba(127, 159, 255, .48);
}

/* Four metric cards: distinct accent colors */
.app-shell .stat-card {
  overflow: hidden;
  min-width: 0;
  animation: gm-card-enter .55s both;
}

.app-shell .stat-card::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 2px;
  opacity: .85;
  background: var(--gm-accent, var(--gm-purple));
}

.app-shell .stat-card::after {
  content: "";
  position: absolute;
  width: 110px;
  height: 110px;
  right: -48px;
  top: -58px;
  border-radius: 50%;
  background: var(--gm-accent, var(--gm-purple));
  opacity: .075;
  filter: blur(18px);
  pointer-events: none;
}

.app-shell .stat-purple {
  --gm-accent: #9868ff;
  border-color: rgba(137, 87, 255, .38) !important;
  background: linear-gradient(135deg, rgba(81, 47, 179, .19), rgba(9, 21, 41, .96)) !important;
}

.app-shell .stat-blue {
  --gm-accent: #219bff;
  border-color: rgba(33, 155, 255, .35) !important;
  background: linear-gradient(135deg, rgba(12, 92, 180, .18), rgba(9, 21, 41, .96)) !important;
}

.app-shell .stat-teal,
.app-shell .stat-green {
  --gm-accent: #00dfc4;
  border-color: rgba(0, 223, 196, .34) !important;
  background: linear-gradient(135deg, rgba(0, 151, 139, .16), rgba(9, 21, 41, .96)) !important;
}

.app-shell .stat-orange,
.app-shell .stat-amber {
  --gm-accent: #ffb340;
  border-color: rgba(255, 179, 64, .34) !important;
  background: linear-gradient(135deg, rgba(178, 106, 21, .16), rgba(9, 21, 41, .96)) !important;
}

.app-shell .stat-icon {
  border: 1px solid color-mix(in srgb, var(--gm-accent, #9868ff) 25%, transparent);
  background: color-mix(in srgb, var(--gm-accent, #9868ff) 15%, transparent);
  color: var(--gm-accent, #9868ff);
  box-shadow: 0 0 18px color-mix(in srgb, var(--gm-accent, #9868ff) 12%, transparent);
  border-radius: 10px;
}

.app-shell .stat-card > strong {
  color: #f4f7ff;
  font-variant-numeric: tabular-nums;
}

.app-shell .stat-card > small {
  color: #8498b7;
}

.app-shell .stat-bullet {
  background: var(--gm-accent, #9868ff) !important;
  box-shadow: 0 0 8px var(--gm-accent, #9868ff);
}

/* Document rows and status chips */
.app-shell .recent-docs {
  gap: 0;
}

.app-shell .recent-docs > *,
.app-shell .recent-questions > * {
  transition: background .2s ease, border-color .2s ease;
}

.app-shell .recent-docs > *:hover,
.app-shell .recent-questions > *:hover {
  background: rgba(60, 103, 177, .09);
}

.app-shell .status {
  border-radius: 999px;
}

.app-shell .status-processed {
  color: #3ee3c4;
  background: rgba(0, 206, 170, .09);
  border-color: rgba(0, 206, 170, .28);
}

.app-shell .status-processing {
  color: #43b4ff;
  background: rgba(30, 144, 255, .10);
  border-color: rgba(30, 144, 255, .27);
}

.app-shell .status-queued {
  color: #a8c3ed;
  background: rgba(92, 129, 182, .10);
  border-color: rgba(92, 129, 182, .27);
}

.app-shell .question-row {
  border-radius: 9px;
  transition: background .2s ease, transform .2s ease;
}

.app-shell .question-row:hover {
  background: rgba(74, 100, 177, .10);
  transform: translateX(2px);
}

.app-shell .question-mark,
.app-shell .tile-icon {
  border: 1px solid rgba(108, 130, 255, .20);
  box-shadow: 0 0 15px rgba(87, 88, 255, .08);
}

.app-shell .action-tile {
  background: rgba(13, 29, 51, .74);
  border: 1px solid rgba(101, 149, 218, .17);
  border-radius: 11px;
  transition: transform .22s ease, border-color .22s ease,
              background .22s ease, box-shadow .22s ease;
}

.app-shell .action-tile:hover {
  transform: translateY(-3px);
  background: rgba(21, 41, 71, .92);
  border-color: rgba(120, 145, 255, .42);
  box-shadow: 0 9px 24px rgba(0, 0, 0, .16);
}

.app-shell .tile-icon.blue {
  color: #55b8ff;
  background: rgba(20, 132, 255, .17);
}

.app-shell .tile-icon.teal,
.app-shell .tile-icon.green {
  color: #28e5d0;
  background: rgba(0, 207, 183, .13);
}

.app-shell .tile-icon.orange,
.app-shell .tile-icon.amber {
  color: #ffc16b;
  background: rgba(255, 169, 55, .14);
}

.app-shell .tile-icon.purple,
.app-shell .tile-icon.violet {
  color: #b39aff;
  background: rgba(133, 87, 255, .16);
}

/* Knowledge graph: animate existing nodes and connections */
.app-shell .graph-panel,
.app-shell .knowledge-graph-panel {
  overflow: hidden;
  background-image: radial-gradient(rgba(78, 139, 235, .16) .8px, transparent .8px) !important;
  background-size: 22px 22px !important;
}

.app-shell .graph-panel svg,
.app-shell .knowledge-graph-panel svg {
  overflow: visible;
}

.app-shell .graph-panel svg path,
.app-shell .knowledge-graph-panel svg path {
  transition: stroke-opacity .25s ease, filter .25s ease;
}

.app-shell .graph-panel svg circle,
.app-shell .knowledge-graph-panel svg circle {
  transform-box: fill-box;
  transform-origin: center;
  animation: gm-node-pulse 3.8s ease-in-out infinite;
}

.app-shell .graph-panel svg circle:nth-of-type(2n),
.app-shell .knowledge-graph-panel svg circle:nth-of-type(2n) {
  animation-delay: -1.7s;
}

.app-shell .graph-panel svg line,
.app-shell .knowledge-graph-panel svg line {
  stroke-opacity: .72;
}

/* Charts and insight blocks */
.app-shell .insight-panel,
.app-shell .questions-panel,
.app-shell .actions-panel,
.app-shell .documents-panel {
  min-width: 0;
}

.app-shell .insight-panel svg,
.app-shell .analytics-chart svg {
  overflow: visible;
}

.app-shell .insight-empty,
.app-shell .mini-empty {
  color: #899dbb;
}

.app-shell .footer {
  color: #6885ad;
  border-top-color: rgba(99, 145, 214, .12);
}

.app-shell .live-dot {
  background: #20e4b5;
  box-shadow: 0 0 10px rgba(32, 228, 181, .7);
}

.app-shell .privacy-card {
  background: linear-gradient(135deg, rgba(14, 38, 61, .82), rgba(9, 22, 39, .85));
  border-color: rgba(82, 157, 218, .21);
}

.app-shell .privacy-icon {
  color: #34e1c5;
}

.app-shell .avatar,
.app-shell .top-avatar {
  background: linear-gradient(140deg, #8060ff, #4d4fe8);
  box-shadow: 0 0 18px rgba(111, 81, 255, .17);
}

.app-shell .state-box {
  background: rgba(12, 26, 46, .76);
  border-color: rgba(102, 149, 220, .20);
}

.app-shell .search-popover {
  background: #0a172b;
  border-color: rgba(101, 149, 218, .25);
  box-shadow: 0 16px 45px rgba(0, 0, 0, .32);
}

@keyframes gm-card-enter {
  from { opacity: 0; transform: translateY(9px); }
  to { opacity: 1; transform: translateY(0); }
}

.app-shell .stats-grid > :nth-child(2) { animation-delay: .06s; }
.app-shell .stats-grid > :nth-child(3) { animation-delay: .12s; }
.app-shell .stats-grid > :nth-child(4) { animation-delay: .18s; }

@keyframes gm-node-pulse {
  0%, 100% { opacity: .82; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .app-shell *,
  .app-shell *::before,
  .app-shell *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}

@media (max-width: 900px) {
  .app-shell .page-header {
    align-items: flex-start;
  }

  .app-shell .stat-card {
    min-width: 0;
  }
}

@media (max-width: 600px) {
  .app-shell .page-stack {
    gap: 14px;
  }

  .app-shell .glass.panel {
    border-radius: 12px !important;
  }

  .app-shell .page-header h1 {
    font-size: clamp(1.5rem, 6vw, 2rem);
  }
}
