# Shared local development configuration
DATABASE_URL=postgresql://user:password@localhost:5432/graphmind
PORT=5000
VITE_PORT=5173
BASE_PATH=/
API_URL=http://localhost:5000

# Replit OIDC authentication
REPL_ID=
ISSUER_URL=https://replit.com/oidc
# Set true only for local development when a Replit client ID is unavailable.
LOCAL_DEV_AUTH=false

# Replit Object Storage (required for PDF upload/processing)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional live answer generation; omit to use clearly-labelled demo search mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
